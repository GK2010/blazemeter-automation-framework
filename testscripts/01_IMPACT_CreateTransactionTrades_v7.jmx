              <stringProp name="script">import groovy.json.JsonSlurper

// Parse the JSON response
def response = prev.getResponseDataAsString()
def jsonSlurper = new JsonSlurper()
def parsedJson = jsonSlurper.parseText(response)

// Extract the token (adjust the key based on your response structure)
String token = parsedJson.access_token

// Store the token as a JMeter property, so it is available across thread groups
props.put(&quot;authToken&quot;, token)
</stringProp>
