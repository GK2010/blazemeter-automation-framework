          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor_ForHeaderTimeStamp" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.TimeZone
import java.util.Date

// Create SimpleDateFormat instance for formattedDate (ISO 8601 format)
SimpleDateFormat sdf_Header = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;)
sdf_Header.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))
String formattedDate = sdf_Header.format(new Date())
vars.put(&quot;formattedTime&quot;, formattedDate)

// Generate a new UUID for this request
def traceId = UUID.randomUUID().toString()
// Store it as a JMeter variable
vars.put(&quot;Trace-ID&quot;, traceId)
log.info(&quot;Generated Create Trade Impact Trace-ID: &quot; + vars.get(&quot;Trace-ID&quot;))</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor_ForBody_ExcludeOffDays">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.*
import java.util.UUID


// === CONFIGURATION ===
// Define holidays to exclude (format: yyyy-MM-dd)
Set&lt;String&gt; holidays = [
    &quot;2025-01-01&quot;, // New Year&apos;s Day
    &quot;2025-12-25&quot;, // Christmas
    &quot;2025-04-18&quot;  // Good Friday (example)
] as Set

// === HELPERS ===

// Check if calendar date is weekend
boolean isWeekend(Calendar cal) {
    int day = cal.get(Calendar.DAY_OF_WEEK)
    return day == Calendar.SATURDAY || day == Calendar.SUNDAY
}

// Format a Date as yyyy-MM-dd (for comparison to holiday list)
String formatDateOnly(Date date) {
    return new SimpleDateFormat(&quot;yyyy-MM-dd&quot;).format(date)
}

// Subtract N business days (excluding weekends and holidays)
Date getBusinessDaysAgo(int targetDays, Set&lt;String&gt; holidays) {
    Calendar cal = Calendar.getInstance()
    int count = 0
    while (count &lt; targetDays) {
        cal.add(Calendar.DAY_OF_YEAR, -1)
        if (!isWeekend(cal) &amp;&amp; !holidays.contains(formatDateOnly(cal.getTime()))) {
            count++
        }
    }
    return cal.getTime()
}

// === FORMATTER ===
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&quot;)
sdf.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))

// Timezone offset as +00:00
TimeZone timeZone = TimeZone.getTimeZone(&quot;UTC&quot;)
Date currentDate = new Date()
int offset = timeZone.getOffset(currentDate.getTime()) / (60 * 1000)
int offsetHours = offset / 60
int offsetMinutes = offset % 60
String offsetStr = String.format(&quot;%+03d:%02d&quot;, offsetHours, offsetMinutes)

// === CALCULATE DATES ===
Date transactionDateRaw = getBusinessDaysAgo(3, holidays) // T-3
Date settlementDateRaw = getBusinessDaysAgo(1, holidays)  // T-1

String transactionDate = sdf.format(transactionDateRaw) + offsetStr
String settlementDateFormatted = sdf.format(settlementDateRaw) + offsetStr

// The rest use current date
String effectiveDate = sdf.format(currentDate) + offsetStr
String entryDate = sdf.format(currentDate) + offsetStr
String publishedDate = sdf.format(currentDate) + offsetStr
String expiryDate = sdf.format(currentDate) + offsetStr

// === SET JMETER VARIABLES ===
vars.put(&quot;transactionDate&quot;, transactionDate)
vars.put(&quot;effectiveDate&quot;, effectiveDate)
vars.put(&quot;entryDate&quot;, entryDate)
vars.put(&quot;publishedDate&quot;, publishedDate)
vars.put(&quot;expiryDate&quot;, expiryDate)
vars.put(&quot;settledDate&quot;, settlementDateFormatted)


// =====================
// TRANSACTION ID
// =====================
def prefix = &quot;CI&quot;
def uuid = UUID.randomUUID().toString().replaceAll(&quot;-&quot;, &quot;&quot;).substring(0, 18).toUpperCase()
def transactionID = prefix + uuid

vars.put(&quot;transactionID&quot;, transactionID)

log.info(&quot;Generated IMPACT Create Trade transactionID: &quot; + transactionID)
</stringProp>
              <stringProp name="TestPlan.comments">ExcludingHolidays and Weekends</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture transactionID Impact" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.io.*
import java.text.SimpleDateFormat

// Get variables
String ScriptName = &quot;ImpactCreateTrade&quot;
String txnID = vars.get(&quot;transactionID&quot;)
String traceId = vars.get(&quot;Trace-ID&quot;)
String threadName = vars.getThreadName()
//String responseCode = prev.getResponseCode() ?: &quot;N/A&quot;

// Add timestamp to identify record
String timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())

// Compose output line
String logLine = &quot;${timestamp}, ${threadName}, ${ScriptName},  ${txnID}, ${traceId}\n&quot;

// Define a unique filename per load generator
String filePath = props.get(&quot;transaction.log.file&quot;)
if (filePath == null) {
    // First time - generate and store in props
    String uuid = UUID.randomUUID().toString()
    filePath = &quot;transactions_${uuid}.csv&quot;
    props.put(&quot;transaction.log.file&quot;, filePath)
}

// Write to file (in JMeter’s working/output dir)
FileWriter fw = new FileWriter(filePath, true)
BufferedWriter bw = new BufferedWriter(fw)
bw.write(logLine)
bw.close()</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture transactionID Impact" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.io.*
import java.text.SimpleDateFormat

// === CONFIGURATION ===
String ScriptName = &quot;ImpactCreateTrade&quot;

// === FETCH VALUES FROM JMeter CONTEXT ===
String txnID = vars.get(&quot;transactionID&quot;) ?: &quot;N/A&quot;
String traceId = vars.get(&quot;Trace-ID&quot;) ?: &quot;N/A&quot;
String responseCode = prev.getResponseCode() ?: &quot;N/A&quot;
//String inputData = vars.get(&quot;InputData&quot;) ?: &quot;N/A&quot; // &lt;-- Replace &apos;InputData&apos; with your CSV variable name
String threadName = vars.getThreadName()
String timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())

// === COMPOSE LOG LINE ===
String logLine = &quot;${timestamp},${threadName},${ScriptName},${traceId},${txnID},${responseCode}\n&quot;

// === GET OR SET FILE PATH ===
String filePath = props.get(&quot;transaction.log.file&quot;)
if (filePath == null) {
    String uuid = UUID.randomUUID().toString()
    filePath = &quot;transactions_${uuid}.csv&quot;
    props.put(&quot;transaction.log.file&quot;, filePath)
}

// === WRITE TO FILE ===
new File(filePath).withWriterAppend { writer -&gt;
    writer.write(logLine)
}</stringProp>
            </JSR223PostProcessor>
