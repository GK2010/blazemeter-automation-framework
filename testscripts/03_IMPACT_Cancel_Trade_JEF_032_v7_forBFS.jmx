          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor_ForHeaderTimeStamp" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.TimeZone
import java.util.Date

// Create SimpleDateFormat instance for formattedDate (ISO 8601 format)
SimpleDateFormat sdf_Header = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;)
sdf_Header.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))
String formattedDate = sdf_Header.format(new Date())
vars.put(&quot;formattedTime&quot;, formattedDate)

// Generate a new UUID for this request
def traceId = UUID.randomUUID().toString()
// Store it as a JMeter variable
vars.put(&quot;Trace-ID&quot;, traceId)
log.info(&quot;Generated Cancel Trade IMPACT Trace-ID: &quot; + vars.get(&quot;Trace-ID&quot;))</stringProp>
            </JSR223PreProcessor>
