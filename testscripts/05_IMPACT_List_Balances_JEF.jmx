          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def propsFilePath = vars.get(&quot;PROPERTY_FILE&quot;)

// Define the fallback path (uat.properties) in case the local file is not found
def fallbackPath = &apos;uat.properties&apos;


// Check if the file exists at the path provided in the User Defined Variables
def propsFile = new File(propsFilePath)

if (propsFile.exists()) {
    log.info(&quot;Using local properties file: &quot; + propsFilePath)
} else {
    log.warn(&quot;Local properties file not found at: &quot; + propsFilePath + &quot;. Falling back to: &quot; + fallbackPath)
    // Fallback to the default relative path if local file not found
    propsFile = new File(fallbackPath)
}

if (propsFile.exists()) {
    def props = new Properties()
    propsFile.withInputStream { stream -&gt; props.load(stream) }
    
    // Add loaded properties to JMeter context
    props.each { key, value -&gt; ctx.getProperties().put(key, value) }
    
    log.info(&quot;Properties loaded from: &quot; + propsFile.getAbsolutePath())
    
    props.each { key, value -&gt;
        log.info(&quot;Loaded property: &quot; + key + &quot; = &quot; + value)
    }
} else {
    log.error(&quot;Properties file not found at: &quot; + propsFile.getAbsolutePath())
}
</stringProp>
