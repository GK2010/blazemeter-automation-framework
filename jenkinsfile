pipeline{
    agent any

    stages{
        
        stage('Checkout') {
            
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {

            steps {
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Execute Blazemeter Automation') {

            steps {
                bat 'python main.py'
            }
        }

        stage('Archive Results') {

            steps {

                archiveArtifacts(
                    artifacts: 'logs/**',
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        always {

            echo 'Blazemeter automation completed'
        }
    }
}